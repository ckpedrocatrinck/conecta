# Copie este arquivo para .env e preencha os valores localmente.
# Nunca commitar .env (já está no .gitignore) nem colar segredo real no chat.
#
# Novas variáveis introduzidas em INCs futuros devem ser documentadas aqui,
# com comentário explicando o propósito de cada uma.
#
# REGRA GERAL PARA QUALQUER SENHA ABAIXO QUE ENTRE NUMA CONNECTION STRING
# (POSTGRES_PASSWORD, APP_DB_PASSWORD): use apenas caracteres alfanuméricos.
# Os caracteres / + = @ : ? # têm significado especial numa URL e, se vierem
# de um gerador de senha aleatória (ex.: `openssl rand -base64`), quebram o
# parsing de DATABASE_URL/APP_DATABASE_URL sem aviso claro do driver.

# Banco de dados (INC-002)
# Docker Compose local: docker compose up -d
#
# POSTGRES_USER e POSTGRES_DB precisam ser IDÊNTICOS aos valores usados nas
# duas connection strings abaixo (DATABASE_URL/APP_DATABASE_URL) — o Compose
# só os usa para inicializar o container, não há sincronização automática.
POSTGRES_USER=conecta
# Só é aplicada quando o volume Docker é CRIADO pela primeira vez
# (`conecta_pgdata`, ver docker-compose.yml). Trocar este valor depois de o
# volume já existir NÃO tem efeito — é preciso `docker compose down -v`
# (apaga os dados) e subir de novo para a nova senha valer.
POSTGRES_PASSWORD=changeme-local-only
POSTGRES_DB=conecta_dev
# Porta do Postgres exposta no host. Mude aqui se 5432 já estiver em uso por
# outro processo/projeto — e ajuste a porta correspondente em DATABASE_URL e
# APP_DATABASE_URL abaixo (eles não leem esta variável automaticamente, são
# strings literais).
POSTGRES_PORT=5432

# Role owner/superuser (compose) — usada só por `prisma migrate` e pelo seed.
# Formato: postgresql://<POSTGRES_USER>:<POSTGRES_PASSWORD>@localhost:<POSTGRES_PORT>/<POSTGRES_DB>
# Livre trocar o valor, desde que os 4 campos batam com as variáveis acima.
DATABASE_URL=postgresql://conecta:changeme-local-only@localhost:5432/conecta_dev

# Role de runtime da aplicação — NÃO é superuser (ADR-003: role de migração e
# role de runtime são deliberadamente diferentes; a aplicação nunca conecta
# como o owner do schema). A role em si é criada por migration; esta senha
# é aplicada nela pelo seed via ALTER ROLE (nunca fica em SQL versionado).
# APP_DB_PASSWORD é livre (só precisa existir e seguir a regra geral do
# topo do arquivo); ela só precisa bater com a senha embutida em
# APP_DATABASE_URL logo abaixo — as duas são a mesma senha, escritas em
# dois lugares.
APP_DB_PASSWORD=changeme-app-role-local-only
# Formato: postgresql://conecta_app:<APP_DB_PASSWORD>@localhost:<POSTGRES_PORT>/<POSTGRES_DB>
# O usuário é sempre "conecta_app" (nome fixo da role, criado por migration)
# e o banco/porta são os mesmos de DATABASE_URL — só a role e a senha mudam.
APP_DATABASE_URL=postgresql://conecta_app:changeme-app-role-local-only@localhost:5432/conecta_dev

# Pepper para hash deterministico de CPF (ADR-006). Valor livre em dev
# (qualquer string serve). Rotacionar = procedimento de emergencia
# documentado; invalida cpf_hash de todos os usuarios.
CPF_HASH_PEPPER=changeme-pepper-dev-only

# Autenticação (INC-003, ADR-005/ADR-007)
# Segredo de assinatura do JWT de sessão do Auth.js. Valor livre em dev.
AUTH_SECRET=changeme-auth-secret-dev-only

# Cron da plataforma (INC-004) — segredo compartilhado que autentica o
# disparo periodico de /api/cron/publish-announcements (nao ha' sessao de
# usuario nesse contexto). Valor livre em dev; precisa bater com o mesmo
# CRON_SECRET lido pelo serviço "scheduler" do docker-compose.yml (ambos
# leem a mesma variável deste .env, então basta definir uma vez).
# A configuracao de QUANDO o cron chama esse endpoint fica fora deste repo
# (infra do host).
CRON_SECRET=changeme-cron-secret-dev-only

# Storage de mídia — R2/S3-compatível (INC-003 usa um storage MOCK local,
# ver src/lib/storage/media-storage.ts; estas envs só passam a ser lidas
# quando um INC futuro plugar o R2 de verdade — deixadas comentadas de
# propósito, sem valor).
# R2_ACCOUNT_ID=
# R2_BUCKET=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=

# Web Push / VAPID (INC-012) — gerar com `npx web-push generate-vapid-keys`.
# A chave publica leva o prefixo NEXT_PUBLIC_ porque o browser precisa dela em
# pushManager.subscribe(); a privada e o subject nunca saem do servidor.
# Os 3 valores abaixo são livres (não precisam bater com nenhum outro
# arquivo) — mas as duas chaves (pública/privada) precisam ser o PAR gerado
# junto pelo mesmo comando, não valores inventados separadamente.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=changeme-vapid-public-dev-only
VAPID_PRIVATE_KEY=changeme-vapid-private-dev-only
VAPID_SUBJECT=mailto:

# Agendador de cron (docker-compose.yml, serviço "scheduler") — variáveis
# livres, com default sensato no próprio docker-compose.yml se omitidas.
# Nome do serviço da app na rede interna do Compose — NUNCA "localhost"
# (dentro do container do agendador, localhost é o próprio agendador).
APP_INTERNAL_URL=http://app:3000
# Intervalo do sweep de publicação agendada, em segundos.
SCHEDULER_PUBLISH_INTERVAL_SECONDS=300
# Hora UTC da anonimização diária (0-23). 3 = meia-noite em America/Sao_Paulo.
SCHEDULER_ANONYMIZE_AT_HOUR_UTC=3
