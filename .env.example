# Copie este arquivo para .env e preencha os valores localmente.
# Nunca commitar .env (já está no .gitignore) nem colar segredo real no chat.
#
# Novas variáveis introduzidas em INCs futuros devem ser documentadas aqui,
# com comentário explicando o propósito de cada uma.

# Banco de dados (INC-002)
# Docker Compose local: docker compose up -d
POSTGRES_USER=conecta
POSTGRES_PASSWORD=changeme-local-only
POSTGRES_DB=conecta_dev

# Role owner/superuser (compose) — usada só por `prisma migrate` e pelo seed.
DATABASE_URL=postgresql://conecta:changeme-local-only@localhost:5432/conecta_dev

# Role de runtime da aplicação (nao-superuser, criada por migration; senha
# aplicada pelo seed via ALTER ROLE — nunca fica em SQL versionado).
APP_DB_PASSWORD=changeme-app-role-local-only
APP_DATABASE_URL=postgresql://conecta_app:changeme-app-role-local-only@localhost:5432/conecta_dev

# Pepper para hash deterministico de CPF (ADR-006). Rotacionar = procedimento
# de emergencia documentado; invalida cpf_hash de todos os usuarios.
CPF_HASH_PEPPER=changeme-pepper-dev-only

# Autenticação (INC-003, ADR-005/ADR-007)
# Segredo de assinatura do JWT de sessão do Auth.js.
AUTH_SECRET=changeme-auth-secret-dev-only

# Storage de mídia — R2/S3-compatível (INC-003 usa um storage MOCK local,
# ver src/lib/storage/media-storage.ts; estas envs só passam a ser lidas
# quando um INC futuro plugar o R2 de verdade — deixadas comentadas de
# propósito, sem valor).
# R2_ACCOUNT_ID=
# R2_BUCKET=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
